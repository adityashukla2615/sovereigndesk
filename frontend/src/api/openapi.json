{
  "openapi": "3.1.0",
  "info": {
    "title": "SovereignDesk API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/data/status": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Data Status",
        "operationId": "getDataStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/data/series/{series_id}": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Series Data",
        "operationId": "getSeries",
        "parameters": [
          {
            "name": "series_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Series Id"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesData"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/commands": {
      "get": {
        "tags": [
          "simulator"
        ],
        "summary": "Commands",
        "operationId": "getCommands",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CommandInfo"
                  },
                  "type": "array",
                  "title": "Response Getcommands"
                }
              }
            }
          }
        }
      }
    },
    "/api/sim/status": {
      "get": {
        "tags": [
          "simulator"
        ],
        "summary": "Sim Status",
        "operationId": "getSimStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommandInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "usage": {
            "type": "string",
            "title": "Usage"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "group": {
            "type": "string",
            "title": "Group"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "available_in": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available In"
          }
        },
        "type": "object",
        "required": [
          "code",
          "usage",
          "summary",
          "group",
          "available",
          "available_in"
        ],
        "title": "CommandInfo"
      },
      "DataStatus": {
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "offline": {
            "type": "boolean",
            "title": "Offline"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
            },
            "type": "array",
            "title": "Sources"
          },
          "series": {
            "items": {
              "$ref": "#/components/schemas/SeriesStatus"
            },
            "type": "array",
            "title": "Series"
          },
          "quality_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Quality Counts"
          }
        },
        "type": "object",
        "required": [
          "generated_at",
          "offline",
          "sources",
          "series",
          "quality_counts"
        ],
        "title": "DataStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "title": "Time"
          },
          "offline": {
            "type": "boolean",
            "title": "Offline"
          },
          "fred_key_configured": {
            "type": "boolean",
            "title": "Fred Key Configured"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "engine_version",
          "time",
          "offline",
          "fred_key_configured"
        ],
        "title": "HealthResponse"
      },
      "Quality": {
        "type": "string",
        "enum": [
          "LIVE",
          "CACHED",
          "SEED",
          "SIMULATED",
          "SYNTHETIC",
          "MISSING"
        ],
        "title": "Quality"
      },
      "SeriesData": {
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/SeriesStatus"
          },
          "dates": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Dates"
          },
          "values": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Values"
          }
        },
        "type": "object",
        "required": [
          "meta",
          "dates",
          "values"
        ],
        "title": "SeriesData"
      },
      "SeriesStatus": {
        "properties": {
          "series_id": {
            "type": "string",
            "title": "Series Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "units": {
            "type": "string",
            "title": "Units"
          },
          "frequency": {
            "type": "string",
            "title": "Frequency"
          },
          "quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "last_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Value"
          },
          "rows": {
            "type": "integer",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "series_id",
          "source",
          "title",
          "units",
          "frequency",
          "quality",
          "label",
          "as_of",
          "last_value",
          "rows"
        ],
        "title": "SeriesStatus"
      },
      "SimStatus": {
        "properties": {
          "running": {
            "type": "boolean",
            "title": "Running"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "paused": {
            "type": "boolean",
            "title": "Paused"
          },
          "speed": {
            "type": "number",
            "title": "Speed"
          },
          "sim_time": {
            "type": "string",
            "title": "Sim Time"
          },
          "anchored_as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchored As Of"
          },
          "input_quality": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Input Quality"
          }
        },
        "type": "object",
        "required": [
          "running",
          "error",
          "paused",
          "speed",
          "sim_time",
          "anchored_as_of",
          "input_quality"
        ],
        "title": "SimStatus"
      },
      "SourceStatus": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "last_attempt_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Attempt At"
          },
          "last_success_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success At"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "rows": {
            "type": "integer",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "source",
          "status",
          "last_attempt_at",
          "last_success_at",
          "message",
          "rows"
        ],
        "title": "SourceStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
