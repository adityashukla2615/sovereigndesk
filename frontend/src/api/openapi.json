{
  "openapi": "3.1.0",
  "info": {
    "title": "SovereignDesk API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/data/status": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Data Status",
        "operationId": "getDataStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/data/series/{series_id}": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Series Data",
        "operationId": "getSeries",
        "parameters": [
          {
            "name": "series_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Series Id"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesData"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/commands": {
      "get": {
        "tags": [
          "simulator"
        ],
        "summary": "Commands",
        "operationId": "getCommands",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CommandInfo"
                  },
                  "type": "array",
                  "title": "Response Getcommands"
                }
              }
            }
          }
        }
      }
    },
    "/api/sim/status": {
      "get": {
        "tags": [
          "simulator"
        ],
        "summary": "Sim Status",
        "operationId": "getSimStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/impact": {
      "post": {
        "tags": [
          "impact"
        ],
        "summary": "Impact",
        "description": "Both Module E views for the given portfolio and businesses (the presets when omitted).",
        "operationId": "postImpact",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImpactRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Postimpact"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BondIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name"
          },
          "face": {
            "type": "number",
            "maximum": 1000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Face"
          },
          "coupon": {
            "type": "number",
            "maximum": 0.3,
            "minimum": 0.0,
            "title": "Coupon",
            "description": "Annual coupon, decimal"
          },
          "years": {
            "type": "number",
            "maximum": 50.0,
            "exclusiveMinimum": 0.0,
            "title": "Years"
          },
          "spread_bp": {
            "type": "number",
            "maximum": 2000.0,
            "minimum": -500.0,
            "title": "Spread Bp",
            "description": "Over the G-sec curve",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "name",
          "face",
          "coupon",
          "years"
        ],
        "title": "BondIn"
      },
      "CommandInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "usage": {
            "type": "string",
            "title": "Usage"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "group": {
            "type": "string",
            "title": "Group"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "available_in": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available In"
          }
        },
        "type": "object",
        "required": [
          "code",
          "usage",
          "summary",
          "group",
          "available",
          "available_in"
        ],
        "title": "CommandInfo"
      },
      "DataStatus": {
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "offline": {
            "type": "boolean",
            "title": "Offline"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
            },
            "type": "array",
            "title": "Sources"
          },
          "series": {
            "items": {
              "$ref": "#/components/schemas/SeriesStatus"
            },
            "type": "array",
            "title": "Series"
          },
          "quality_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Quality Counts"
          }
        },
        "type": "object",
        "required": [
          "generated_at",
          "offline",
          "sources",
          "series",
          "quality_counts"
        ],
        "title": "DataStatus"
      },
      "FundIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name"
          },
          "value": {
            "type": "number",
            "maximum": 1000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Value"
          },
          "modified_duration": {
            "type": "number",
            "maximum": 40.0,
            "minimum": 0.0,
            "title": "Modified Duration"
          },
          "convexity": {
            "type": "number",
            "maximum": 3000.0,
            "minimum": 0.0,
            "title": "Convexity"
          }
        },
        "type": "object",
        "required": [
          "name",
          "value",
          "modified_duration",
          "convexity"
        ],
        "title": "FundIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "title": "Time"
          },
          "offline": {
            "type": "boolean",
            "title": "Offline"
          },
          "fred_key_configured": {
            "type": "boolean",
            "title": "Fred Key Configured"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "engine_version",
          "time",
          "offline",
          "fred_key_configured"
        ],
        "title": "HealthResponse"
      },
      "ImpactRequest": {
        "properties": {
          "bonds": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/BondIn"
                },
                "type": "array",
                "maxItems": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Bonds"
          },
          "funds": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FundIn"
                },
                "type": "array",
                "maxItems": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Funds"
          },
          "profiles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProfileIn"
                },
                "type": "array",
                "maxItems": 10
              },
              {
                "type": "null"
              }
            ],
            "title": "Profiles"
          },
          "shift_bp": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000.0,
                "minimum": -1000.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Shift Bp",
            "description": "Hypothetical yields"
          },
          "repo_bp": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 500.0,
                "minimum": -500.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Bp",
            "description": "Hypothetical repo move"
          },
          "inr_pct": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 50.0,
                "minimum": -50.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Inr Pct",
            "description": "Hypothetical rupee move"
          }
        },
        "type": "object",
        "title": "ImpactRequest"
      },
      "IndiaStatus": {
        "properties": {
          "running": {
            "type": "boolean",
            "title": "Running"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "anchored_as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchored As Of"
          },
          "input_quality": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Input Quality"
          }
        },
        "type": "object",
        "required": [
          "running",
          "error",
          "anchored_as_of",
          "input_quality"
        ],
        "title": "IndiaStatus"
      },
      "LoanIn": {
        "properties": {
          "amount": {
            "type": "number",
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Amount"
          },
          "benchmark": {
            "type": "string",
            "enum": [
              "EBLR",
              "MCLR"
            ],
            "title": "Benchmark"
          },
          "spread": {
            "type": "number",
            "maximum": 0.2,
            "minimum": -0.05,
            "title": "Spread"
          },
          "reset_months": {
            "type": "integer",
            "maximum": 36.0,
            "minimum": 1.0,
            "title": "Reset Months"
          },
          "first_reset_month": {
            "type": "integer",
            "maximum": 36.0,
            "minimum": 0.0,
            "title": "First Reset Month"
          },
          "tenor_months": {
            "type": "integer",
            "maximum": 360.0,
            "minimum": 1.0,
            "title": "Tenor Months"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "benchmark",
          "spread",
          "reset_months",
          "first_reset_month",
          "tenor_months"
        ],
        "title": "LoanIn"
      },
      "ProfileIn": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Key"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "monthly_sales": {
            "type": "number",
            "maximum": 1000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Monthly Sales"
          },
          "cost_share": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Cost Share"
          },
          "import_share": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Import Share"
          },
          "fx_to_price": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Fx To Price"
          },
          "inventory_days": {
            "type": "number",
            "maximum": 730.0,
            "minimum": 0.0,
            "title": "Inventory Days"
          },
          "rate_semi_elasticity": {
            "type": "number",
            "maximum": 0.0,
            "minimum": -50.0,
            "title": "Rate Semi Elasticity"
          },
          "price_elasticity": {
            "type": "number",
            "maximum": 0.0,
            "minimum": -20.0,
            "title": "Price Elasticity"
          },
          "loan": {
            "$ref": "#/components/schemas/LoanIn"
          }
        },
        "type": "object",
        "required": [
          "key",
          "name",
          "monthly_sales",
          "cost_share",
          "import_share",
          "fx_to_price",
          "inventory_days",
          "rate_semi_elasticity",
          "price_elasticity",
          "loan"
        ],
        "title": "ProfileIn"
      },
      "Quality": {
        "type": "string",
        "enum": [
          "LIVE",
          "CACHED",
          "SEED",
          "SIMULATED",
          "SYNTHETIC",
          "MISSING"
        ],
        "title": "Quality"
      },
      "SeriesData": {
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/SeriesStatus"
          },
          "dates": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Dates"
          },
          "values": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Values"
          }
        },
        "type": "object",
        "required": [
          "meta",
          "dates",
          "values"
        ],
        "title": "SeriesData"
      },
      "SeriesStatus": {
        "properties": {
          "series_id": {
            "type": "string",
            "title": "Series Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "units": {
            "type": "string",
            "title": "Units"
          },
          "frequency": {
            "type": "string",
            "title": "Frequency"
          },
          "quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "last_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Value"
          },
          "rows": {
            "type": "integer",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "series_id",
          "source",
          "title",
          "units",
          "frequency",
          "quality",
          "label",
          "as_of",
          "last_value",
          "rows"
        ],
        "title": "SeriesStatus"
      },
      "SimStatus": {
        "properties": {
          "running": {
            "type": "boolean",
            "title": "Running"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "paused": {
            "type": "boolean",
            "title": "Paused"
          },
          "speed": {
            "type": "number",
            "title": "Speed"
          },
          "sim_time": {
            "type": "string",
            "title": "Sim Time"
          },
          "anchored_as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchored As Of"
          },
          "input_quality": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Input Quality"
          },
          "india": {
            "$ref": "#/components/schemas/IndiaStatus"
          }
        },
        "type": "object",
        "required": [
          "running",
          "error",
          "paused",
          "speed",
          "sim_time",
          "anchored_as_of",
          "input_quality",
          "india"
        ],
        "title": "SimStatus"
      },
      "SourceStatus": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "last_attempt_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Attempt At"
          },
          "last_success_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success At"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "rows": {
            "type": "integer",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "source",
          "status",
          "last_attempt_at",
          "last_success_at",
          "message",
          "rows"
        ],
        "title": "SourceStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
