{
  "openapi": "3.1.0",
  "info": {
    "title": "SovereignDesk API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "title": "Time"
          },
          "offline": {
            "type": "boolean",
            "title": "Offline"
          },
          "fred_key_configured": {
            "type": "boolean",
            "title": "Fred Key Configured"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "engine_version",
          "time",
          "offline",
          "fred_key_configured"
        ],
        "title": "HealthResponse"
      }
    }
  }
}
